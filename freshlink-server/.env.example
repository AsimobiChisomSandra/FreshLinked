MONGO_URI=mongodb://127.0.0.1:27017/freshlink
JWT_SECRET=replace_with_a_long_secret
PORT=5000

# If you are using MongoDB Atlas, replace the value above with your cluster URI.
# Example: mongodb+srv://<user>:<password>@cluster.mongodb.net/freshlink
# If the Atlas IP address is not whitelisted, the app will fall back to the local database URL above.
